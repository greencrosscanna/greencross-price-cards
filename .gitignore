.DS_Store
*.log
.vscode/
.gx_deploy_secret
.clasprc.json
.claude/settings.local.json
# Throwaway shell written to a file instead of run inline — the shell-safety analyzer prompts on
# inline loops/case/heredocs even under bypass permissions, so logic goes in a script and the script
# gets run plainly. Scratch only; anything worth keeping moves up to scripts/ and is committed.
scripts/tmp/*
!scripts/tmp/.gitkeep
